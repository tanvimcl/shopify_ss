<style>
    
</style>



{% assign collection = section.settings.collection %}
{% assign selected_collection =  collections[collection] %}

<div class="page-width">
{% for product in selected_collection.products %}
<img
  class="featured-image-cp"
  src="{{ product.featured_image | image_url: width: 200 }}"
  width="200"
  height="200"
  alt="{{ product.title }}"
>  
    {{ product.price| money }}
    {{ product.compare_at_price | money}}
{% endfor %}
</div>

{% schema %}
    {
        "name": "Collection Picker",
        "settings": [
            {
                "type": "collection",
                "id": "collection",
                "label": "Select-collection"
            }
        ],
        "presets": [
            {
                "name": "Collection Picker GM"
            }
        ]
    }
{% endschema %}