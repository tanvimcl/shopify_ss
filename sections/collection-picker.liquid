<style>
.collection-picker {
    display: flex;
}
    .featured-image-cp {
        width: 500px;
        height: auto;
        object-fit: contain;
    }
</style>

{% assign collection = section.settings.collection %}
{% assign selected_collection =  collections[collection] %}

<div class="collection-picker page-width">
{% for product in selected_collection.products %}
    <div class="collection-picker-pcards">
        <img
        class="featured-image-cp"
        src="{{ product.featured_image | image_url: width: 500 }}"
        width="500"
        height="500"
        alt="{{ product.title }}"
        >  
        {{ product.price| money }}
        {{ product.compare_at_price | money}}
    </div>
{% endfor %}
</div>

{% schema %}
    {
        "name": "Collection Picker",
        "settings": [
            {
                "type": "collection",
                "id": "collection",
                "label": "Select-collection"
            }
        ],
        "presets": [
            {
                "name": "Collection Picker GM"
            }
        ]
    }
{% endschema %}