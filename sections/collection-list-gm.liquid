<style>
    .collection-list-container-{{ section.id }}{
        width: 100vw;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 1rem;
        justify-content: center;
        box-sizing: border-box;
        margin-left: auto;
        margin-top: auto;
    }
    .collection-image-{{ section.id }}{
        width: 100%;
        height: auto;
        object-fit: cover;
        border: 3px solid #000;
    }
    @media screen and (max-width: 767px){
        .collection-list-container-{{ section.id }} {
            grid-template-columns: 1fr 1fr 1fr 1fr
        }
    }
</style>

<div style="text.align: center;">
    {{ section.settings.collection_list_heading }}
</div>
<div class="collection-list-container-{{ section.id }}">

    {% for block in section.blocks %}
        <a class="collection-link-{{ section.id }}" href="{{ block.settings.collection_link }}">
            <img class="collection-image-{{ section.id }}" src="{{ block.settings.collection_image | img_url }}" />
        </a>
    {% endfor %}
</div>



{% schema %}
    {
        "name": "Collection List GM",
        "settings": [
            {
                "type": "richtext",
                "id": "collection_list_heading",
                "label": "Collection Heading",
                "default": "<h4>Explore Our Best Sellers</h4>"
            }
        ],
        "blocks": [
            {
                "type": "collection-list",
                "name": "Collection List",
                    "settings": [
                        {
                            "type": "image_picker",
                            "id": "collection_image",
                            "label": "Select Image"
                        },
                        {
                            "type": "url",
                            "id": "collection_link",
                            "label": "Select Collection"
                        }
                    ]
            }
        ],
        "presets": [
            {
                "name": "Collection List GM"
            }
        ]
    }
{% endschema %}