<style>
    .collection-list-container-{{ section.id }}{
        width: 100vw;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        justify-content: center;
        box-sizing: border-box;
    }
    .collection-image-{{ section.id }}{
        width: 100%;
        height: auto;
        object-fit: cover;
    }
</style>



<div class="collection-list-container-{{ section.id }}">
    {% for block in section.blocks %}
        <a class="collection-link-{{ section.id }}" href="{{ block.settings.collection_link }}">
            <img class="collection-image-{{ section.id }}" src="{{ block.settings.collection_image | img_url }}" />
        </a>
    {% endfor %}
</div>




{% schema %}
    {
        "name": "Collection List GM",
        "settings": [],
        "blocks": [
            {
                "type": "collection-list",
                "name": "Collection List",
                    "settings": [
                        {
                            "type": "image_picker",
                            "id": "collection_image",
                            "label": "Select Image"
                        },
                        {
                            "type": "url",
                            "id": "collection_link",
                            "label": "Select Collection"
                        }
                    ]
            }
        ],
        "presets": [
            {
                "name": "Collection List GM"
            }
        ]
    }
{% endschema %}