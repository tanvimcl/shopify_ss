<style>

</style>

<div class="page-width">
    <h1>{{ section.settings.heading_text }}</h1>
    <h3> Hey.</h3>

    {% if section.settings.mylucky_number > 0 %}
        {{ section.settings.mylucky_number }}
    {% endif %}
</div>

{% schema %}
    {
        "name": "Class 1",
        "settings": [
            {
                "type": "text",
                "id": "heading_text",
                "label": "Heading GM"
            },
            {
                "type": "textarea",
                "id": "paragraph_text", 
                "label": "Write Paragraph",
                "default": "Tell your brand story here."
            },
            {
                "type": "number",
                "id": "mylucky_number",
                "label": "Lucky Number",
                "default": 123
            }
        ],
        "blocks": [],
        "presets": [
            {
                "name": "Class 1"
            }
        ]
    }
{% endschema %}



