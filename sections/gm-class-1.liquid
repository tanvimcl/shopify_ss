<style>
h1{
    padding-top: {{ section.settings.padding_top }}rem;
    font-size: {{ section.settings.headingfont_size }}px;    
}
</style>

<div class="page-width">
    {% if section.settings.show_heading == true %}
        <h1 style="text-align: {{ section.settings.heading_alignment }};">{{ section.settings.heading_text }}</h1>
    {% endif %}


    {% if section.settings.mylucky_number > 0 %}
        {{ section.settings.mylucky_number }}
    {% endif %}
</div>

{% schema %}
    {
        "name": "Class 1",
        "settings": [
            {
                "type": "text",
                "id": "heading_text",
                "label": "Heading GM"
            },
            {
                "type": "textarea",
                "id": "paragraph_text", 
                "label": "Write Paragraph",
                "default": "Tell your brand story here."
            },
            {
                "type": "number",
                "id": "mylucky_number",
                "label": "Lucky Number",
                "default": 123
            },
            {
                "type": "range",
                "id": "padding_top",
                "label": "Padding Top",
                "min": 5, 
                "max": 100,
                "step": 5,
                "unit": "rem",
                "default": 5
            },
            {
                "type": "range",
                "id": "headingfont_size",
                "label": "Heading Font Size",
                "min": 1,
                "max": 100,
                "step": 1,
                "default": 15,
                "unit": "px"
            },
            {
                "type": "select",
                "id": "heading_alignment",
                "label": "Heading Alignment",
                "options": [
                    {
                        "value": "left",
                        "label": "Left Align"
                    },
                    {
                        "value": "center",
                        "label": "Center Align"
                    },
                    {
                        "value": "right",
                        "label": "Right Align"
                    }
                ],
                "default": "center"
            },
            {
                "type": "checkbox",
                "id": "show_heading",
                "label": "Show Heading",
                "default": true
            }
        ],
        "blocks": [],
        "presets": [
            {
                "name": "Class 1"
            }
        ]
    }
{% endschema %}



