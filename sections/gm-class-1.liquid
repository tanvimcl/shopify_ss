<style>
h1{
    padding-top: {{ section.settings.padding_top }}rem;
    font-size: {{ section.settings.headingfont_size }}px;
}
</style>

<div class="page-width">
    <h1>{{ section.settings.heading_text }}</h1>
    <h3> Hey.</h3>

    {% if section.settings.mylucky_number > 0 %}
        {{ section.settings.mylucky_number }}
    {% endif %}
</div>

{% schema %}
    {
        "name": "Class 1",
        "settings": [
            {
                "type": "text",
                "id": "heading_text",
                "label": "Heading GM"
            },
            {
                "type": "textarea",
                "id": "paragraph_text", 
                "label": "Write Paragraph",
                "default": "Tell your brand story here."
            },
            {
                "type": "number",
                "id": "mylucky_number",
                "label": "Lucky Number",
                "default": 123
            },
            {
                "type": "range",
                "id": "padding_top",
                "label": "Padding Top",
                "min": 5, 
                "max": 100,
                "step": 5,
                "unit": "rem",
                "default": 5
            },
            {
                "type": "range",
                "id": "headingfont_size",
                "label": "Heading Font Size",
                "min": 1,
                "max": 100,
                "step": 1,
                "default": 15,
                "unit": "px"
            }
        ],
        "blocks": [],
        "presets": [
            {
                "name": "Class 1"
            }
        ]
    }
{% endschema %}



